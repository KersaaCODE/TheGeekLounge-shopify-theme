<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {% render 'css-variables' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <main style="display:flex;align-items:center;justify-content:center;min-height:100vh;text-align:center;padding:32px;">
    <div>
      <h1 style="font-family:'Space Grotesk',sans-serif;font-size:2rem;margin-bottom:16px;">{{ shop.name }}</h1>
      {{ content_for_layout }}
    </div>
  </main>
</body>
</html>
