{%- if section.settings.show_bar -%}
<div id="announcementBar" style="
  background:linear-gradient(90deg, var(--accent), var(--secondary));
  color:#000; text-align:center; padding:10px 20px;
  font-family:'JetBrains Mono',monospace; font-size:0.75rem; font-weight:600;
  letter-spacing:1px; position:relative; z-index:1001;
">
  {%- if section.settings.link_url != blank -%}
    <a href="{{ section.settings.link_url }}" style="color:#000;text-decoration:none;">
      {{ section.settings.text }}
    </a>
  {%- else -%}
    {{ section.settings.text }}
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "checkbox", "id": "show_bar",  "label": "Show announcement bar", "default": true },
    { "type": "text",     "id": "text",      "label": "Announcement text",     "default": "🔥 Free shipping on orders over $50 — New drops every Friday!" },
    { "type": "url",      "id": "link_url",  "label": "Link (optional)" }
  ]
}
{% endschema %}
