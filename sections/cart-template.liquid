<section class="cart-page">
  <div class="cart-page__inner">
    <h1 class="cart-page__title">{{ 'general.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div class="cart-item">
            {%- if item.image -%}
              <img class="cart-item__image" src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" loading="lazy">
            {%- else -%}
              <div class="cart-item__image" style="background:var(--glass);"></div>
            {%- endif -%}
            <div>
              <div class="cart-item__title">
                <a href="{{ item.url }}" style="color:white;text-decoration:none;">{{ item.product.title }}</a>
              </div>
              {%- unless item.product.has_only_default_variant -%}
                <div class="cart-item__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-item__price">{{ item.final_line_price | money }}</div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;">
              <div class="cart-item__qty">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
              </div>
              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item__remove">{{ 'general.cart.remove' | t }}</a>
            </div>
          </div>
        {%- endfor -%}

        <div class="cart-footer">
          <div class="cart-footer__total">Total: <span>{{ cart.total_price | money }}</span></div>
          <button type="submit" name="update" class="btn-primary" style="margin-bottom:8px;">{{ 'general.cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn-primary btn-lg">{{ 'general.cart.checkout' | t }}</button>
        </div>
      </form>
    {%- else -%}
      <div class="cart-page__empty">
        <p>{{ 'general.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top:24px;">{{ 'general.cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Template",
  "settings": []
}
{% endschema %}
