{%- assign fc = section.settings.collection -%}
<section id="featured" style="position:relative;z-index:1;padding:100px 32px;">
  <div class="eyebrow reveal">{{ section.settings.eyebrow | default: '// Latest Drops' }}</div>
  <div class="sec-title reveal gradient-text">{{ section.settings.title | default: 'Latest Drops' }}</div>
  <p class="sec-sub reveal">{{ section.settings.subtitle | default: 'Fresh pulls just landed. Grab them before they are gone.' }}</p>

  <div class="product-grid" style="max-width:1200px;margin:0 auto;">
    {%- if fc -%}
      {%- for product in fc.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Show all products as fallback when no collection picked {%- endcomment -%}
      {%- for product in collections.all.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div style="text-align:center;margin-top:48px;">
    {%- if fc -%}
      <a href="{{ fc.url }}" class="btn-primary">View All {{ fc.title }}</a>
    {%- else -%}
      <a href="/collections/all" class="btn-primary">View All Products</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text",       "id": "eyebrow", "label": "Eyebrow",    "default": "// Latest Drops" },
    { "type": "text",       "id": "title",   "label": "Title",      "default": "Latest Drops" },
    { "type": "textarea",   "id": "subtitle","label": "Subtitle",   "default": "Fresh pulls just landed. Grab them before they are gone." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range",      "id": "limit",   "label": "Products to show", "min": 4, "max": 16, "step": 2, "default": 8 }
  ],
  "presets": [
    { "name": "Featured Collection" }
  ]
}
{% endschema %}
