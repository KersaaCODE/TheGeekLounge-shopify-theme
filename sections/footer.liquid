<footer>
  <div class="foot">
    <div class="foot-brand">
      {% render 'logo-svg', width: 22, height: 22 %}
      <span class="foot-name"><span class="g">{{ section.settings.brand_first | default: 'TheGeek' }}</span>{{ section.settings.brand_second | default: 'Lounge' }}</span>
    </div>

    <!-- Social links -->
    {%- if settings.social_discord or settings.social_instagram or settings.social_tiktok or settings.social_twitter or settings.social_youtube -%}
      <div class="foot-social">
        {%- if settings.social_discord -%}<a href="{{ settings.social_discord }}" target="_blank" rel="noopener" aria-label="Discord" class="foot-social__link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        </a>{%- endif -%}
        {%- if settings.social_instagram -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="foot-social__link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
        </a>{%- endif -%}
        {%- if settings.social_tiktok -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok" class="foot-social__link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.52a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.46V13a8.28 8.28 0 005.58 2.15V11.7a4.81 4.81 0 01-3.59-1.42V6.69h3.59z"/></svg>
        </a>{%- endif -%}
        {%- if settings.social_twitter -%}<a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" aria-label="X / Twitter" class="foot-social__link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>{%- endif -%}
        {%- if settings.social_youtube -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube" class="foot-social__link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="foot-tags">
      <span class="ft pk">POKEMON TCG</span>
      <span class="ft op">ONE PIECE TCG</span>
      <span class="ft na">NARUTO TCG</span>
      <span class="ft ll">LOL RIFT BOUND</span>
    </div>

    {%- if section.settings.footer_menu != blank -%}
      <div class="foot-links">
        {%- for link in linklists[section.settings.footer_menu].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="foot-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/refund-policy">Refund Policy</a>
        <a href="/policies/shipping-policy">Shipping Policy</a>
        <a href="/collections/all">Shop All</a>
      </div>
    {%- endif -%}

    <p class="foot-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Collecting since day one.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text",      "id": "brand_first",  "label": "Brand (Highlighted)", "default": "TheGeek" },
    { "type": "text",      "id": "brand_second", "label": "Brand (Normal)",      "default": "Lounge" },
    { "type": "link_list", "id": "footer_menu",  "label": "Footer Menu" }
  ]
}
{% endschema %}
