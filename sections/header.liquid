<nav id="navbar">
  <div class="nav-inner">
    <a href="{{ routes.root_url }}" class="nav-logo">
      {% render 'logo-svg', width: 26, height: 26 %}
      <span class="nav-logo-text"><span class="g">{{ section.settings.brand_first | default: 'TheGeek' }}</span>{{ section.settings.brand_second | default: 'Lounge' }}</span>
    </a>

    <!-- Desktop nav -->
    <div class="nav-links nav-desktop">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link' -%}
            <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- when 'cta' -%}
            <a href="{{ block.settings.url | default: routes.all_products_collection_url }}" class="nav-cta" {{ block.shopify_attributes }}>{{ block.settings.label | default: 'Shop Now' }}</a>
        {%- endcase -%}
      {%- endfor -%}
      <a href="{{ routes.cart_url }}" class="nav-cart" aria-label="Cart ({{ cart.item_count }} items)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="nav-cart__count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Mobile: cart + hamburger -->
    <div class="nav-mobile-actions">
      <a href="{{ routes.cart_url }}" class="nav-cart" aria-label="Cart ({{ cart.item_count }} items)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="nav-cart__count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
      <button id="navToggle" class="nav-hamburger" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div id="mobileMenu" class="mobile-menu">
  <div class="mobile-menu__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'link' -%}
          <a href="{{ block.settings.url }}" class="mobile-menu__link">{{ block.settings.label }}</a>
        {%- when 'cta' -%}
          <a href="{{ block.settings.url | default: routes.all_products_collection_url }}" class="btn-primary" style="margin-top:16px;text-align:center;">{{ block.settings.label | default: 'Shop Now' }}</a>
      {%- endcase -%}
    {%- endfor -%}
    <a href="{{ routes.cart_url }}" class="mobile-menu__link">Cart ({{ cart.item_count }})</a>
    {%- if customer -%}
      <a href="{{ routes.account_url }}" class="mobile-menu__link">Account</a>
      <a href="{{ routes.account_logout_url }}" class="mobile-menu__link">Logout</a>
    {%- else -%}
      <a href="{{ routes.account_login_url }}" class="mobile-menu__link">Login</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "brand_first",  "label": "Brand Name (Highlighted)", "default": "TheGeek" },
    { "type": "text", "id": "brand_second", "label": "Brand Name (Normal)",      "default": "Lounge" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "url",  "id": "url",   "label": "URL" }
      ]
    },
    {
      "type": "cta",
      "name": "CTA Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label",  "default": "Shop Now" },
        { "type": "url",  "id": "url",   "label": "URL" }
      ]
    }
  ]
}
{% endschema %}
