<nav id="navbar">
  <div class="nav-inner">
    <a href="{{ routes.root_url }}" class="nav-logo">
      {% render 'logo-svg', width: 26, height: 26 %}
      <span class="nav-logo-text"><span class="g">{{ section.settings.brand_first | default: 'TheGeek' }}</span>{{ section.settings.brand_second | default: 'Lounge' }}</span>
    </a>
    <div class="nav-links">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link' -%}
            <a href="{{ block.settings.url }}" class="nav-link-text" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- when 'cta' -%}
            <a href="{{ block.settings.url | default: routes.all_products_collection_url }}" class="nav-cta" {{ block.shopify_attributes }}>{{ block.settings.label | default: 'Shop Now' }}</a>
        {%- endcase -%}
      {%- endfor -%}
      <a href="{{ routes.cart_url }}" class="nav-cart" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="nav-cart__count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "brand_first",  "label": "Brand Name (Highlighted)", "default": "TheGeek" },
    { "type": "text", "id": "brand_second", "label": "Brand Name (Normal)",      "default": "Lounge" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "url",  "id": "url",   "label": "URL" }
      ]
    },
    {
      "type": "cta",
      "name": "CTA Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label",  "default": "Shop Now" },
        { "type": "url",  "id": "url",   "label": "URL" }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
