<!-- Load screen -->
<div id="loadScreen">
  <div class="ls-wrap">
    {% render 'logo-svg', width: 44, height: 44 %}
    <div class="ls-name"><span class="g">{{ section.settings.brand_first | default: 'TheGeek' }}</span>{{ section.settings.brand_second | default: 'Lounge' }}</div>
    <div class="ls-mono">{{ section.settings.loading_text | default: 'Entering the lounge' }}</div>
  </div>
</div>

<section id="intro">
  <!-- Intro video (plays once) -->
  <video id="introVideo" class="intro-vid" autoplay muted playsinline preload="auto"
    {%- if section.settings.poster_image -%} poster="{{ section.settings.poster_image | image_url: width: 1920 }}"{%- endif -%}>
    <source src="{{ 'intro.mp4' | asset_url }}" type="video/mp4">
  </video>

  <!-- Hover video (loops, fades in when intro ends) -->
  <video id="hoverVideo" class="intro-vid" muted playsinline loop preload="auto">
    <source src="{{ 'hover.mp4' | asset_url }}" type="video/mp4">
  </video>

  <!-- ── PRODUCT MINI-CARDS ────────────────────────────── -->
  <div id="miniCards">
    {%- for block in section.blocks -%}
      {%- if block.type == 'product_card' -%}
        {%- assign prod = block.settings.product -%}
        {%- assign hs_color = block.settings.color | default: '#00FF6A' -%}
        {%- assign hs_r = hs_color | color_extract: 'red' -%}
        {%- assign hs_g = hs_color | color_extract: 'green' -%}
        {%- assign hs_b = hs_color | color_extract: 'blue' -%}

        <a href="{{ prod.url | default: block.settings.fallback_url | default: '#' }}"
           class="mini-card"
           style="left:{{ block.settings.pos_x }}%;top:{{ block.settings.pos_y }}%;--mc-r:{{ hs_r }};--mc-g:{{ hs_g }};--mc-b:{{ hs_b }};"
           {{ block.shopify_attributes }}>
          <div class="mc-glow"></div>
          <div class="mc-inner">
            {%- if prod.featured_image -%}
              <div class="mc-img">
                <img src="{{ prod.featured_image | image_url: width: 200 }}"
                     alt="{{ prod.title | escape }}"
                     loading="lazy" width="80" height="112">
              </div>
            {%- else -%}
              <div class="mc-img mc-placeholder">
                <svg viewBox="0 0 40 56" fill="none"><rect width="40" height="56" rx="4" fill="rgba({{ hs_r }},{{ hs_g }},{{ hs_b }},0.15)"/><path d="M12 20h16M12 28h10M12 36h14" stroke="rgba({{ hs_r }},{{ hs_g }},{{ hs_b }},0.4)" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
            {%- endif -%}
            <div class="mc-info">
              <span class="mc-name">{{ prod.title | default: block.settings.label | truncate: 22 }}</span>
              {%- if prod.price -%}
                <span class="mc-price" style="color:rgb({{ hs_r }},{{ hs_g }},{{ hs_b }});">{{ prod.price | money }}</span>
              {%- else -%}
                <span class="mc-tag" style="color:rgb({{ hs_r }},{{ hs_g }},{{ hs_b }});">{{ block.settings.label }}</span>
              {%- endif -%}
            </div>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- Holographic shimmer overlay -->
  <div id="holo"></div>

  <!-- Brand mark -->
  <div id="introBrand">
    {% render 'logo-svg', width: 20, height: 20 %}
    <span><span class="g">{{ section.settings.brand_first | default: 'TheGeek' }}</span>{{ section.settings.brand_second | default: 'Lounge' }}</span>
  </div>

  <!-- Scroll down hint -->
  <div id="scrollHint">
    <span>Scroll to explore</span>
    <div class="arr"></div>
  </div>
</section>

<script>
(function(){
  var loadScreen = document.getElementById('loadScreen');
  var introVideo = document.getElementById('introVideo');
  var hoverVideo = document.getElementById('hoverVideo');
  var miniCards  = document.getElementById('miniCards');
  var scrollHint = document.getElementById('scrollHint');
  var holo       = document.getElementById('holo');
  var introEl    = document.getElementById('intro');
  var cards      = document.querySelectorAll('.mini-card');

  introVideo.addEventListener('canplay', function(){
    loadScreen.style.opacity = '0';
    setTimeout(function(){ loadScreen.style.display = 'none'; }, 500);
  }, { once: true });

  introVideo.addEventListener('error', function(){
    loadScreen.style.opacity = '0';
    setTimeout(function(){ loadScreen.style.display = 'none'; }, 500);
  });

  introVideo.addEventListener('ended', function(){
    introVideo.pause();
    hoverVideo.play().catch(function(){});
    hoverVideo.classList.add('active');
    setTimeout(function(){ introVideo.style.display = 'none'; }, 450);

    /* Stagger mini-cards in */
    miniCards.classList.add('show');
    cards.forEach(function(c, i){
      setTimeout(function(){ c.classList.add('show'); }, 300 + i * 150);
    });
    setTimeout(function(){ holo.classList.add('active'); }, 600);
    setTimeout(function(){ scrollHint.classList.add('show'); }, 900);
  });

  /* Holographic mouse tracking */
  introEl.addEventListener('mousemove', function(e){
    var r = introEl.getBoundingClientRect();
    var x = ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%';
    var y = ((e.clientY - r.top) / r.height * 100).toFixed(1) + '%';
    var ang = (Math.atan2(e.clientY - r.top - r.height/2, e.clientX - r.left - r.width/2) * 180 / Math.PI).toFixed(1) + 'deg';
    holo.style.setProperty('--holo-x', x);
    holo.style.setProperty('--holo-y', y);
    holo.style.setProperty('--holo-angle', ang);

    /* Subtle parallax on mini-cards */
    var mx = (e.clientX - r.left) / r.width - 0.5;
    var my = (e.clientY - r.top)  / r.height - 0.5;
    cards.forEach(function(c){
      var d = parseFloat(c.getAttribute('data-depth') || '1');
      c.style.transform = 'translate(' + (mx * 8 * d) + 'px,' + (my * 6 * d) + 'px)';
    });
  });
})();
</script>

{% schema %}
{
  "name": "Hero Video",
  "settings": [
    { "type": "text",         "id": "brand_first",   "label": "Brand (Highlighted)", "default": "TheGeek" },
    { "type": "text",         "id": "brand_second",  "label": "Brand (Normal)",      "default": "Lounge" },
    { "type": "text",         "id": "loading_text",  "label": "Loading Text",        "default": "Entering the lounge" },
    { "type": "image_picker", "id": "poster_image",  "label": "Poster Image (fallback)" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "product",  "id": "product",       "label": "Product" },
        { "type": "text",     "id": "label",         "label": "Fallback Label", "default": "Shop Now" },
        { "type": "url",      "id": "fallback_url",  "label": "Fallback URL (if no product)" },
        { "type": "color",    "id": "color",         "label": "Card Accent",    "default": "#00FF6A" },
        { "type": "range",    "id": "pos_x",         "label": "X Position (%)", "min": 2, "max": 88, "step": 1, "default": 15 },
        { "type": "range",    "id": "pos_y",         "label": "Y Position (%)", "min": 2, "max": 85, "step": 1, "default": 60 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Video",
      "blocks": [
        { "type": "product_card", "settings": { "label": "Pokemon TCG",    "color": "#FFE500", "pos_x": 8,  "pos_y": 68 } },
        { "type": "product_card", "settings": { "label": "One Piece TCG",  "color": "#FF6B2B", "pos_x": 30, "pos_y": 72 } },
        { "type": "product_card", "settings": { "label": "Naruto TCG",     "color": "#FF4500", "pos_x": 54, "pos_y": 68 } },
        { "type": "product_card", "settings": { "label": "LoL Rift Bound", "color": "#00C0FF", "pos_x": 76, "pos_y": 72 } }
      ]
    }
  ]
}
{% endschema %}
