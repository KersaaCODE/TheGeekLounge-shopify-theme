<section class="collection-page">
  <div class="collection-header">
    <h1>{{ blog.title }}</h1>
  </div>
  <div class="product-grid" style="max-width:1000px;margin:0 auto;">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" style="text-decoration:none;color:white;" class="product-card">
        {%- if article.image -%}
          <div class="product-card__image-wrap">
            <img class="product-card__image" src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" loading="lazy">
          </div>
        {%- endif -%}
        <div class="product-card__info">
          <h3 class="product-card__title">{{ article.title }}</h3>
          <p style="color:var(--text-sec);font-size:0.82rem;">{{ article.published_at | date: '%B %d, %Y' }}</p>
          <p style="color:var(--text-sec);font-size:0.88rem;margin-top:8px;line-height:1.5;">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
  {%- if blog.articles.size == 0 -%}
    <p style="text-align:center;color:var(--text-sec);padding:60px 0;">No articles yet.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
