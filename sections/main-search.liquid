<section class="search-page">
  <h1>{{ 'general.search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" class="search-page__form">
    <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" class="search-page__input">
    <button type="submit" class="btn-primary">Search</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="product-grid" style="max-width:1200px;margin:0 auto;">
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            {% render 'product-card', product: result %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color:var(--text-sec);">{{ 'general.search.no_results' | t }} "{{ search.terms }}"</p>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search Page",
  "settings": []
}
{% endschema %}
