<section id="newsletter" style="position:relative;z-index:1;padding:100px 32px;border-top:1px solid var(--border);">
  <div style="max-width:560px;margin:0 auto;text-align:center;">
    <span class="cta-eye reveal type-cursor">{{ section.settings.eyebrow | default: '// Stay In The Loop' }}</span>
    <h2 class="cta-h reveal gradient-text" style="font-size:clamp(1.6rem,4vw,2.4rem);">{{ section.settings.heading | default: 'Never Miss a Drop' }}</h2>
    <p class="cta-sub">{{ section.settings.subheading | default: "New arrivals, restocks, and exclusive deals — straight to your inbox. No spam, just cards." }}</p>

    {% form 'customer', id: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display:flex;gap:12px;max-width:480px;margin:0 auto;">
        <input type="email" name="contact[email]" placeholder="your@email.com" required
          class="search-page__input" style="flex:1;"
          aria-label="Email address">
        <button type="submit" class="btn-primary">{{ section.settings.button_label | default: 'Subscribe' }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p style="color:var(--accent);margin-top:16px;font-family:'JetBrains Mono',monospace;font-size:0.82rem;">
          ✓ You're in! Welcome to the lounge.
        </p>
      {%- endif -%}
      {%- if form.errors -%}
        <p style="color:#ff5555;margin-top:16px;font-size:0.85rem;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {% endform %}

    <p style="color:var(--text-muted);font-size:0.72rem;margin-top:16px;">No spam. Unsubscribe anytime.</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text",     "id": "eyebrow",      "label": "Eyebrow",      "default": "// Stay In The Loop" },
    { "type": "text",     "id": "heading",       "label": "Heading",      "default": "Never Miss a Drop" },
    { "type": "textarea", "id": "subheading",    "label": "Subheading",   "default": "New arrivals, restocks, and exclusive deals — straight to your inbox. No spam, just cards." },
    { "type": "text",     "id": "button_label",  "label": "Button Label", "default": "Subscribe" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
