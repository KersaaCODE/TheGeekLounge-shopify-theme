<section class="product-page">
  <div class="product-page__inner">
    <!-- Gallery -->
    <div class="product-page__gallery">
      <div class="product-page__main-image" id="mainImageWrap">
        {%- if product.featured_image -%}
          <img id="mainProductImage"
               src="{{ product.featured_image | image_url: width: 960 }}"
               alt="{{ product.featured_image.alt | escape }}"
               width="960"
               height="{{ 960 | divided_by: product.featured_image.aspect_ratio | round }}">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div style="display:flex;gap:8px;margin-top:12px;overflow-x:auto;">
          {%- for image in product.images -%}
            <button class="product-thumb" data-src="{{ image | image_url: width: 960 }}" data-alt="{{ image.alt | escape }}"
              style="flex:0 0 72px;width:72px;height:72px;border-radius:8px;overflow:hidden;border:2px solid {% if forloop.first %}var(--accent){% else %}var(--border){% endif %};background:var(--glass);cursor:pointer;padding:0;">
              <img src="{{ image | image_url: width: 144 }}" alt="{{ image.alt | escape }}" style="width:100%;height:100%;object-fit:cover;">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Info -->
    <div class="product-page__info">
      {%- if product.vendor -%}
        <p style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--accent);letter-spacing:2px;text-transform:uppercase;">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="product-page__price" id="productPrice">
        <span id="priceDisplay">{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="product-page__compare-price" id="comparePriceDisplay">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- form 'product', product -%}
        <input type="hidden" name="id" id="variantId" value="{{ product.selected_or_first_available_variant.id }}">

        {%- if product.has_only_default_variant == false -%}
          <div class="product-page__variants">
            {%- for option in product.options_with_values -%}
              <div>
                <label class="product-page__variant-label" for="option-{{ option.name | handleize }}">{{ option.name }}</label>
                <select class="product-page__variant-select js-option-select" id="option-{{ option.name | handleize }}" data-index="{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <option value="{{ value }}" {% if value == option.selected_value %}selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="product-page__qty">
          <label class="product-page__variant-label" for="qty">{{ 'products.product.quantity' | t }}</label>
          <input type="number" id="qty" name="quantity" value="1" min="1">
        </div>

        <button type="submit" class="btn-primary" id="addToCartBtn"
          {%- unless product.selected_or_first_available_variant.available %} disabled{%- endunless -%}>
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product-page__description">
          <h3 style="font-size:1rem;margin-bottom:12px;color:var(--text);">{{ 'products.product.description' | t }}</h3>
          {{ product.description }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function(){
  /* Variant data from Shopify */
  var variants = {{ product.variants | json }};
  var optionSelects = document.querySelectorAll('.js-option-select');
  var variantIdInput = document.getElementById('variantId');
  var priceDisplay = document.getElementById('priceDisplay');
  var comparePriceDisplay = document.getElementById('comparePriceDisplay');
  var addToCartBtn = document.getElementById('addToCartBtn');
  var mainImage = document.getElementById('mainProductImage');

  if (!optionSelects.length) return;

  function getSelectedOptions(){
    var selected = [];
    optionSelects.forEach(function(sel){ selected.push(sel.value); });
    return selected;
  }

  function findVariant(options){
    return variants.find(function(v){
      return v.options.every(function(opt, i){ return opt === options[i]; });
    });
  }

  function formatMoney(cents){
    return (cents / 100).toLocaleString('en-US', { style: 'currency', currency: {{ shop.currency | json }} });
  }

  function onVariantChange(){
    var selected = getSelectedOptions();
    var variant = findVariant(selected);
    if (!variant) return;

    /* Update hidden input */
    variantIdInput.value = variant.id;

    /* Update price */
    priceDisplay.textContent = formatMoney(variant.price);
    if (comparePriceDisplay) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        comparePriceDisplay.textContent = formatMoney(variant.compare_at_price);
        comparePriceDisplay.style.display = '';
      } else {
        comparePriceDisplay.style.display = 'none';
      }
    }

    /* Update button */
    if (variant.available) {
      addToCartBtn.disabled = false;
      addToCartBtn.textContent = {{ 'products.product.add_to_cart' | t | json }};
    } else {
      addToCartBtn.disabled = true;
      addToCartBtn.textContent = {{ 'products.product.sold_out' | t | json }};
    }

    /* Update image */
    if (variant.featured_image && mainImage) {
      mainImage.src = variant.featured_image.src.replace(/(\.[^.]+)$/, '_960x$1');
      mainImage.alt = variant.featured_image.alt || '';
    }

    /* Update URL without reload */
    if (history.replaceState) {
      var url = new URL(window.location);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url);
    }
  }

  optionSelects.forEach(function(sel){
    sel.addEventListener('change', onVariantChange);
  });

  /* Thumbnail gallery */
  var thumbs = document.querySelectorAll('.product-thumb');
  thumbs.forEach(function(thumb){
    thumb.addEventListener('click', function(){
      if (!mainImage) return;
      mainImage.src = this.dataset.src;
      mainImage.alt = this.dataset.alt || '';
      thumbs.forEach(function(t){ t.style.borderColor = 'var(--border)'; });
      this.style.borderColor = 'var(--accent)';
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Template",
  "settings": []
}
{% endschema %}
