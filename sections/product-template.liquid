{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="product-page">
  <div class="product-page__inner">
    <!-- ═══ GALLERY ═══ -->
    <div class="product-page__gallery">
      <div class="product-page__main-image" id="mainImageWrap">
        {%- if product.featured_image -%}
          <img id="mainProductImage"
               src="{{ product.featured_image | image_url: width: 960 }}"
               alt="{{ product.featured_image.alt | escape }}"
               width="960"
               height="{{ 960 | divided_by: product.featured_image.aspect_ratio | round }}">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-thumbs">
          {%- for image in product.images -%}
            <button class="product-thumb{% if forloop.first %} active{% endif %}"
                    data-src="{{ image | image_url: width: 960 }}"
                    data-alt="{{ image.alt | escape }}">
              <img src="{{ image | image_url: width: 144 }}" alt="{{ image.alt | escape }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- ═══ PRODUCT INFO ═══ -->
    <div class="product-page__info">
      {%- if product.vendor -%}
        <a href="{{ product.vendor | url_for_vendor }}" class="product-page__vendor">{{ product.vendor }}</a>
      {%- endif -%}

      <h1 class="product-page__title">{{ product.title }}</h1>

      <!-- Price -->
      <div class="product-page__price" id="productPrice">
        <span id="priceDisplay" class="product-page__current-price">{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span id="comparePriceDisplay" class="product-page__compare-price">{{ current_variant.compare_at_price | money }}</span>
          <span class="product-page__save-badge" id="saveBadge">
            Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
          </span>
        {%- else -%}
          <span id="comparePriceDisplay" class="product-page__compare-price" style="display:none;"></span>
          <span class="product-page__save-badge" id="saveBadge" style="display:none;"></span>
        {%- endif -%}
      </div>

      <!-- Stock indicator -->
      <div id="stockIndicator" class="product-page__stock">
        {%- if current_variant.available -%}
          {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 5 and current_variant.inventory_quantity > 0 -%}
            <span class="stock-low">🔥 Only {{ current_variant.inventory_quantity }} left — going fast!</span>
          {%- else -%}
            <span class="stock-in">✓ In Stock — Ready to Ship</span>
          {%- endif -%}
        {%- else -%}
          <span class="stock-out">Sold Out</span>
        {%- endif -%}
      </div>

      <!-- Tags as pills (set name, rarity, etc.) -->
      {%- if product.tags.size > 0 -%}
        <div class="product-page__tags">
          {%- for tag in product.tags -%}
            <span class="product-page__tag">{{ tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Add to cart form -->
      {%- form 'product', product -%}
        <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">

        {%- if product.has_only_default_variant == false -%}
          <div class="product-page__variants">
            {%- for option in product.options_with_values -%}
              <div class="product-page__option">
                <label class="product-page__variant-label" for="option-{{ option.name | handleize }}">{{ option.name }}</label>
                <select class="product-page__variant-select js-option-select" id="option-{{ option.name | handleize }}" data-index="{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <option value="{{ value }}" {% if value == option.selected_value %}selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="product-page__actions">
          <div class="product-page__qty">
            <button type="button" class="qty-btn" id="qtyMinus" aria-label="Decrease quantity">−</button>
            <input type="number" id="qty" name="quantity" value="1" min="1" aria-label="Quantity">
            <button type="button" class="qty-btn" id="qtyPlus" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="btn-primary product-page__add-btn" id="addToCartBtn"
            {%- unless current_variant.available %} disabled{%- endunless -%}>
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }} — {{ current_variant.price | money }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <!-- Trust badges -->
      {% render 'trust-badges' %}

      <!-- Description -->
      {%- if product.description != blank -%}
        <div class="product-page__description">
          <button class="product-page__accordion" id="descToggle" aria-expanded="true">
            Description <span class="acc-icon">−</span>
          </button>
          <div class="product-page__accordion-body" id="descBody">
            {{ product.description }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function(){
  /* Variant data */
  var variants = {{ product.variants | json }};
  var optionSelects = document.querySelectorAll('.js-option-select');
  var variantIdInput = document.getElementById('variantId');
  var priceDisplay = document.getElementById('priceDisplay');
  var comparePriceDisplay = document.getElementById('comparePriceDisplay');
  var saveBadge = document.getElementById('saveBadge');
  var addToCartBtn = document.getElementById('addToCartBtn');
  var mainImage = document.getElementById('mainProductImage');
  var stockIndicator = document.getElementById('stockIndicator');

  function getSelectedOptions(){
    var selected = [];
    optionSelects.forEach(function(sel){ selected.push(sel.value); });
    return selected;
  }

  function findVariant(options){
    return variants.find(function(v){
      return v.options.every(function(opt, i){ return opt === options[i]; });
    });
  }

  function formatMoney(cents){
    return (cents / 100).toLocaleString('en-US', { style: 'currency', currency: {{ shop.currency | json }} });
  }

  function onVariantChange(){
    var selected = getSelectedOptions();
    var variant = findVariant(selected);
    if (!variant) return;

    variantIdInput.value = variant.id;

    /* Price */
    priceDisplay.textContent = formatMoney(variant.price);
    if (variant.compare_at_price && variant.compare_at_price > variant.price) {
      comparePriceDisplay.textContent = formatMoney(variant.compare_at_price);
      comparePriceDisplay.style.display = '';
      saveBadge.textContent = 'Save ' + formatMoney(variant.compare_at_price - variant.price);
      saveBadge.style.display = '';
    } else {
      comparePriceDisplay.style.display = 'none';
      saveBadge.style.display = 'none';
    }

    /* Button */
    if (variant.available) {
      addToCartBtn.disabled = false;
      addToCartBtn.textContent = {{ 'products.product.add_to_cart' | t | json }} + ' — ' + formatMoney(variant.price);
    } else {
      addToCartBtn.disabled = true;
      addToCartBtn.textContent = {{ 'products.product.sold_out' | t | json }};
    }

    /* Stock */
    if (variant.available) {
      if (variant.inventory_management === 'shopify' && variant.inventory_quantity <= 5 && variant.inventory_quantity > 0) {
        stockIndicator.innerHTML = '<span class="stock-low">🔥 Only ' + variant.inventory_quantity + ' left — going fast!</span>';
      } else {
        stockIndicator.innerHTML = '<span class="stock-in">✓ In Stock — Ready to Ship</span>';
      }
    } else {
      stockIndicator.innerHTML = '<span class="stock-out">Sold Out</span>';
    }

    /* Image */
    if (variant.featured_image && mainImage) {
      mainImage.src = variant.featured_image.src.replace(/(\.[^.]+)$/, '_960x$1');
      mainImage.alt = variant.featured_image.alt || '';
    }

    /* URL */
    if (history.replaceState) {
      var url = new URL(window.location);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url);
    }
  }

  optionSelects.forEach(function(sel){ sel.addEventListener('change', onVariantChange); });

  /* Thumbnail gallery */
  document.querySelectorAll('.product-thumb').forEach(function(thumb){
    thumb.addEventListener('click', function(){
      if (!mainImage) return;
      mainImage.src = this.dataset.src;
      mainImage.alt = this.dataset.alt || '';
      document.querySelectorAll('.product-thumb').forEach(function(t){ t.classList.remove('active'); });
      this.classList.add('active');
    });
  });

  /* Quantity buttons */
  var qtyInput = document.getElementById('qty');
  var qtyMinus = document.getElementById('qtyMinus');
  var qtyPlus = document.getElementById('qtyPlus');
  if (qtyMinus) qtyMinus.addEventListener('click', function(){ qtyInput.value = Math.max(1, parseInt(qtyInput.value) - 1); });
  if (qtyPlus) qtyPlus.addEventListener('click', function(){ qtyInput.value = parseInt(qtyInput.value) + 1; });

  /* Description accordion */
  var descToggle = document.getElementById('descToggle');
  var descBody = document.getElementById('descBody');
  if (descToggle && descBody) {
    descToggle.addEventListener('click', function(){
      var open = descBody.style.display !== 'none';
      descBody.style.display = open ? 'none' : 'block';
      descToggle.querySelector('.acc-icon').textContent = open ? '+' : '−';
      descToggle.setAttribute('aria-expanded', !open);
    });
  }
})();
</script>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
