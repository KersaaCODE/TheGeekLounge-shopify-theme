<section id="universes">
  <div class="sec-title reveal gradient-text">{{ section.settings.title | default: 'Shop by Universe' }}</div>
  <p class="sec-sub reveal">{{ section.settings.subtitle | default: 'Four legendary universes. One lounge. Find your game and start pulling.' }}</p>
  <div class="u-grid">
    {%- for block in section.blocks -%}
      {%- assign card_url = block.settings.collection.url | default: block.settings.fallback_url | default: '/collections/all' -%}
      <a href="{{ card_url }}"
         class="u-card tilt-card"
         style="border-left:3px solid {{ block.settings.color }};"
         {{ block.shopify_attributes }}>
        <div class="u-head">
          <div class="u-icon">{{ block.settings.icon }}</div>
          <div class="u-info">
            {%- assign badge_color = block.settings.color | default: '#FFE500' -%}
            {%- assign badge_r = badge_color | color_extract: 'red' -%}
            {%- assign badge_g = badge_color | color_extract: 'green' -%}
            {%- assign badge_b = badge_color | color_extract: 'blue' -%}
            <span class="u-badge" style="background:rgba({{ badge_r }},{{ badge_g }},{{ badge_b }},0.12);color:{{ badge_color }};">{{ block.settings.badge }}</span>
            <div class="u-name">{{ block.settings.name }}</div>
          </div>
        </div>
        <div class="u-desc">{{ block.settings.description }}</div>
        {%- if block.settings.tags != blank -%}
          <div class="u-tags">
            {%- assign tag_list = block.settings.tags | split: ',' -%}
            {%- for tag in tag_list -%}
              <span class="u-tag">{{ tag | strip }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="u-cta" style="color:{{ block.settings.color }};">{{ block.settings.cta_label | default: 'Browse' }} <span class="u-arrow">→</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Universe Cards",
  "settings": [
    { "type": "text",     "id": "title",    "label": "Title",    "default": "Shop by Universe" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Four legendary universes. One lounge. Find your game and start pulling." }
  ],
  "blocks": [
    {
      "type": "universe",
      "name": "Universe",
      "settings": [
        { "type": "collection", "id": "collection",   "label": "Collection (pick in editor)" },
        { "type": "url",        "id": "fallback_url",  "label": "Fallback URL (if no collection picked)" },
        { "type": "text",       "id": "icon",          "label": "Icon (emoji)",    "default": "⚡" },
        { "type": "text",       "id": "badge",         "label": "Badge Label",     "default": "Pokémon TCG" },
        { "type": "text",       "id": "name",          "label": "Display Name",    "default": "Pokémon Cards & Sealed" },
        { "type": "textarea",   "id": "description",   "label": "Description" },
        { "type": "color",      "id": "color",         "label": "Brand Color",     "default": "#FFE500" },
        { "type": "text",       "id": "tags",          "label": "Tags (comma-separated)", "default": "Booster Packs, Elite Trainer Boxes, Sealed Sets, Rare Singles" },
        { "type": "text",       "id": "cta_label",     "label": "CTA Label",       "default": "Browse Pokémon" }
      ]
    }
  ],
  "presets": [
    { "name": "Universe Cards" }
  ]
}
{% endschema %}
