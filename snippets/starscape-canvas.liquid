{%- if settings.enable_starscape -%}
<canvas id="starscape" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:0.55;"></canvas>
<script>
(function(){
  var c=document.getElementById('starscape'),x=c.getContext('2d');
  var s=[];
  function resize(){
    var d=devicePixelRatio||1;
    c.width=innerWidth*d;c.height=innerHeight*d;
    c.style.width=innerWidth+'px';c.style.height=innerHeight+'px';
    x.scale(d,d);init();
  }
  function init(){
    s=[];
    for(var i=0;i<200;i++){
      var t=Math.random();
      var col=t<0.15?'140,255,170':t<0.3?'180,140,255':'255,255,255';
      s.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.2+0.3,o:Math.random()*0.5+0.2,dx:(Math.random()-0.5)*0.025,dy:(Math.random()-0.5)*0.015,ts:Math.random()*0.0008+0.0003,tp:Math.random()*Math.PI*2,col:col});
    }
  }
  function draw(){
    x.clearRect(0,0,innerWidth,innerHeight);
    var now=Date.now();
    s.forEach(function(p){
      p.x+=p.dx;p.y+=p.dy;
      if(p.x<0)p.x=innerWidth;if(p.x>innerWidth)p.x=0;
      if(p.y<0)p.y=innerHeight;if(p.y>innerHeight)p.y=0;
      var op=Math.max(0,p.o+Math.sin(now*p.ts+p.tp)*0.25);
      x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);
      x.fillStyle='rgba('+p.col+','+op+')';x.fill();
    });
    requestAnimationFrame(draw);
  }
  resize();window.addEventListener('resize',resize);draw();
})();
</script>
{%- endif -%}
