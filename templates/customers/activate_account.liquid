<section class="collection-page">
  <div class="collection-header">
    <h1>Activate Account</h1>
    <p>Create your password to activate your account.</p>
  </div>
  <div style="max-width:420px;margin:0 auto;">
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <div style="display:flex;flex-direction:column;gap:16px;">
        <div>
          <label class="product-page__variant-label" for="password">Password</label>
          <input type="password" name="customer[password]" id="password" autocomplete="new-password" class="search-page__input" style="width:100%;" required>
        </div>
        <div>
          <label class="product-page__variant-label" for="password_confirmation">Confirm Password</label>
          <input type="password" name="customer[password_confirmation]" id="password_confirmation" autocomplete="new-password" class="search-page__input" style="width:100%;" required>
        </div>
        <button type="submit" class="btn-primary" style="width:100%;">Activate Account</button>
        <p style="text-align:center;">
          <a href="{{ routes.account_login_url }}" style="color:var(--text-sec);text-decoration:none;font-size:0.85rem;">Decline Invitation</a>
        </p>
      </div>
    {% endform %}
  </div>
</section>
