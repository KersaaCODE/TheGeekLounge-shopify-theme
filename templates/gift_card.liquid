<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ 'Gift Card' }} — {{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin:0; padding:0; }
    body { background:#0A0812; color:#fff; font-family:'Space Grotesk',sans-serif; display:flex; align-items:center; justify-content:center; min-height:100vh; padding:32px; }
    .gc { text-align:center; max-width:480px; width:100%; }
    .gc h1 { font-size:1.5rem; margin-bottom:8px; }
    .gc .shop-name { color:rgba(255,255,255,0.5); font-size:0.9rem; margin-bottom:32px; }
    .gc-card {
      background:linear-gradient(135deg, rgba(0,255,106,0.1), rgba(160,32,240,0.1));
      border:1px solid rgba(0,255,106,0.2); border-radius:20px;
      padding:40px 32px; margin-bottom:24px;
    }
    .gc-amount { font-size:3rem; font-weight:700; color:#00FF6A; margin-bottom:8px; }
    .gc-code {
      font-family:'JetBrains Mono',monospace; font-size:1.2rem; letter-spacing:3px;
      background:rgba(255,255,255,0.06); padding:14px 24px; border-radius:10px;
      border:1px solid rgba(255,255,255,0.1); display:inline-block; margin-top:16px;
      user-select:all;
    }
    .gc-exp { color:rgba(255,255,255,0.4); font-size:0.82rem; margin-top:16px; }
    .gc-qr { margin:24px auto 0; }
    .gc-qr img { border-radius:12px; }
    .gc-btn {
      background:#00FF6A; color:#000; padding:14px 32px; border-radius:12px;
      font-weight:700; font-size:0.95rem; text-decoration:none; display:inline-block;
      margin-top:24px; transition:all 0.2s;
    }
    .gc-btn:hover { box-shadow:0 0 28px rgba(0,255,106,0.4); transform:translateY(-2px); }
  </style>
</head>
<body>
  <div class="gc">
    <h1>Gift Card</h1>
    <p class="shop-name">{{ shop.name }}</p>
    <div class="gc-card">
      <div class="gc-amount">{{ gift_card.balance | money }}</div>
      <p style="color:rgba(255,255,255,0.5);font-size:0.85rem;">Remaining Balance</p>
      <div class="gc-code" id="giftCardCode">{{ gift_card.code | format_code }}</div>
      {%- if gift_card.expires_on -%}
        <p class="gc-exp">Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>
      {%- endif -%}
    </div>
    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" class="gc-btn">Add to Apple Wallet</a>
    {%- endif -%}
    <div class="gc-qr">{{ gift_card | qr_code: 200 }}</div>
    <a href="{{ shop.url }}" class="gc-btn" style="margin-top:16px;">Shop Now</a>
  </div>
</body>
</html>
